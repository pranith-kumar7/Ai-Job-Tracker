# Backend
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai-job-tracker
JWT_SECRET=replace-with-a-secure-secret
# Select either openai or openrouter
AI_PROVIDER=openrouter

# OpenRouter (use the key from your OpenRouter account)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Job Tracker

# Optional OpenAI settings if AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60
AI_RATE_LIMIT_PER_MINUTE=30
CLIENT_ORIGIN=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
