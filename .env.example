# Backend
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai-job-tracker
JWT_SECRET=replace-with-a-secure-secret

# AI: free-only is enabled by default. The backend will use OpenRouter only.
AI_FREE_ONLY=true
AI_PROVIDER=openrouter

# OpenRouter (create a key at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=recursive/flint-v1.0:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Job Tracker

# Paid OpenAI is disabled while AI_FREE_ONLY=true.
# Only set AI_FREE_ONLY=false if you deliberately want to enable paid-provider usage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60
AI_RATE_LIMIT_PER_MINUTE=30
CLIENT_ORIGIN=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
